# Only needed if you use the optional `cloudflared` service in
# docker-compose.yml to expose the app via a Cloudflare Tunnel.
# Get this from the Cloudflare Zero Trust dashboard: Networks > Tunnels >
# your tunnel > Install connector > copy the token from the run command.
CF_TUNNEL_TOKEN=

# --- Signaling server (server/main.py) — all optional, sane defaults baked in ---

# Comma-separated CORS allow-list for the HTTP endpoints (issue #7).
# ALLOWED_ORIGINS=https://peerdrop.sshogunn.org,http://localhost:5173

# Hard cap on concurrent rooms; excess create_room gets a "server_busy" error (#6).
# MAX_ROOMS=500

# Per-IP sliding-window rate limit on create_room/join_room (#6).
# RATE_LIMIT_MAX=30          # max attempts per window
# RATE_LIMIT_WINDOW=60       # window length in seconds

# Reap rooms created but never joined by a second peer (#5).
# ROOM_TTL_SECONDS=600       # drop unmatched rooms older than this
# ROOM_CLEANUP_INTERVAL=60   # how often the sweep runs, in seconds

# Cloudflare TURN (Realtime) — backend mints short-lived ICE credentials that
# the client fetches from GET /turn-credentials. Create a TURN app in the
# Cloudflare dashboard (Realtime > TURN) to get the key ID + API token.
# Leave blank to run STUN-only (direct connections only, no relay fallback).
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
# TURN_CREDENTIAL_TTL=86400
