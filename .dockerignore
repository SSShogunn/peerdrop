# Keep the build context small and avoid leaking local state / secrets into
# image builds. The build context is the repo root (docker-compose `context: .`).

# Dependencies (reinstalled inside the image from lockfiles)
**/node_modules
**/.venv
**/__pycache__
**/*.py[oc]

# Build output
client/dist
client/dist-ssr

# Secrets / local env (root .env only — client/.env has no secrets, it's
# public client-side config that Vite must read at build time)
.env
.env.*
!.env.example

# VCS / editor / OS
.git
.gitignore
**/.DS_Store
.vscode
.idea

# Docs & compose (not needed inside images)
ENHANCEMENTS.md
docker-compose*.yml
