# WebSocket URL of the signaling server (server/main.py), e.g.
# ws://localhost:8000/ws for local dev or wss://your-domain/ws in production.
VITE_SIGNALING_SERVER=ws://localhost:8000/ws

# Comma-separated list of STUN server URLs used for WebRTC NAT traversal.
VITE_ICE_SERVERS=stun:stun.l.google.com:19302

# Chunk size for file transfer, in KB.
VITE_CHUNK_SIZE=16

# Optional TURN relay, used as a fallback when direct/STUN connections fail
# (e.g. behind strict corporate NATs). Leave unset to skip TURN entirely.
# VITE_TURN_URL=turn:your-turn-server:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
